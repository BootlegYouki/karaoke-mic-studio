{
  "manifest_version": 3,
  "name": "Karaoke Mic Studio",
  "version": "1.0.0",
  "description": "Low-latency live microphone monitoring and vocal studio for karaoke in Chrome.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Karaoke Mic Studio"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
